HOST=127.0.0.1
PORT=3333
VEE_MCP_VERSION=0.2.0

# Optional: if set, /mcp requires "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=

# n8n REST backend (used by vee.n8n.* tools)
N8N_BASE_URL=https://n8n.mmcriativos.cloud/api/v1
N8N_API_KEY=
N8N_TIMEOUT_MS=20000

# global write switch (execution still requires approval)
N8N_WRITE_ENABLED=false

# Laravel audit endpoint
VEE_AUDIT_URL=http://mmcriativos.test/api/internal/vee/mcp/calls
VEE_AUDIT_TOKEN=

# Laravel approval endpoint
VEE_CONTROL_BASE_URL=http://mmcriativos.test/api/internal/vee/mcp
VEE_CONTROL_TOKEN=
VEE_CONTROL_TIMEOUT_MS=20000

# Obsidian vault
OBSIDIAN_ROOT_PATH=
OBSIDIAN_MAX_FILE_BYTES=524288

# Obsidian write controls (Etapa 1 — v0.2.0)
# Set to true to enable write tools (create_note, append_to_note, update_note_section, append_to_daily_log, create_task_note)
OBSIDIAN_WRITE_ENABLED=false
# Comma-separated list of folders allowed for write. Empty = full vault allowed.
# OBSIDIAN_WRITE_ALLOWED_FOLDERS=Vee,operacional,Sessoes,tecnico/decisoes

# Server SSH (read-only base operations)
SERVER_SSH_HOST=
SERVER_SSH_PORT=22
SERVER_SSH_USERNAME=
SERVER_SSH_PASSWORD=
SERVER_SSH_PRIVATE_KEY_PATH=
SERVER_SSH_READY_TIMEOUT_MS=15000
SERVER_SSH_COMMAND_TIMEOUT_MS=20000

# SSH expanded controls (Etapa 2 — v0.2.0)
# Enable docker restart_container tool (requires container also in allowlist)
SERVER_SSH_RESTART_ENABLED=false
# Comma-separated container names allowed for restart. Empty = all containers allowed.
# SERVER_SSH_ALLOWED_CONTAINERS=n8n,mmcc,evolution-api-1,evolution-api-2,redis
# Comma-separated services allowed for service_status. Empty = defaults (docker,nginx,mysql,postgresql,redis,n8n-worker).
# SERVER_SSH_ALLOWED_SERVICES=docker,nginx,mysql
# Comma-separated log path prefixes allowed for tail_log. Empty = defaults (/var/log/nginx,/var/log/mysql,...).
# SERVER_SSH_ALLOWED_LOG_PATHS=/var/log/nginx,/var/log/mysql,/var/log/docker

# Vault over SSH — use this when the mcp-server runs in Docker and can't access
# the Obsidian vault directly on the host filesystem.
# Set to the absolute path of the vault root on the SSH server.
# Requires SERVER_SSH_HOST / SERVER_SSH_USERNAME to be configured.
# Example (Linux): VAULT_SSH_PATH=/home/user/MM-Brain
VAULT_SSH_PATH=

# Public endpoint for Claude connector (optional)
CLAUDE_MCP_PUBLIC_URL=
