HOST=127.0.0.1
PORT=3333
VEE_MCP_VERSION=0.2.0

# Optional: if set, /mcp requires "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=

# n8n REST backend (used by vee.n8n.* tools)
N8N_BASE_URL=https://n8n.mmcriativos.cloud/api/v1
N8N_API_KEY=
N8N_TIMEOUT_MS=20000

# global write switch (execution still requires approval)
N8N_WRITE_ENABLED=false

# Laravel audit endpoint
VEE_AUDIT_URL=http://mmcriativos.test/api/internal/vee/mcp/calls
VEE_AUDIT_TOKEN=

# Laravel approval endpoint
VEE_CONTROL_BASE_URL=http://mmcriativos.test/api/internal/vee/mcp
VEE_CONTROL_TOKEN=
VEE_CONTROL_TIMEOUT_MS=20000

# Obsidian vault
OBSIDIAN_ROOT_PATH=
OBSIDIAN_MAX_FILE_BYTES=524288

# Obsidian write controls (Etapa 1 - v0.2.0)
# Set to true to enable write tools (create_note, append_to_note, update_note_section, append_to_daily_log, create_task_note)
OBSIDIAN_WRITE_ENABLED=false
# Comma-separated list of folders allowed for write. Empty = full vault allowed.
# OBSIDIAN_WRITE_ALLOWED_FOLDERS=Vee,operacional,Sessoes,tecnico/decisoes

# Server SSH (read-only base operations)
SERVER_SSH_HOST=
SERVER_SSH_PORT=22
SERVER_SSH_USERNAME=
SERVER_SSH_PASSWORD=
SERVER_SSH_PRIVATE_KEY_PATH=
SERVER_SSH_READY_TIMEOUT_MS=15000
SERVER_SSH_COMMAND_TIMEOUT_MS=20000

# SSH expanded controls (Etapa 2 - v0.2.0)
# Enable docker restart_container tool (requires container also in allowlist)
SERVER_SSH_RESTART_ENABLED=false
# Comma-separated container names allowed for restart. Empty = all containers allowed.
# SERVER_SSH_ALLOWED_CONTAINERS=n8n,mmcc,evolution-api-1,evolution-api-2,redis
# Comma-separated services allowed for service_status. Empty = defaults (docker,nginx,mysql,postgresql,redis,n8n-worker).
# SERVER_SSH_ALLOWED_SERVICES=docker,nginx,mysql
# Comma-separated log path prefixes allowed for tail_log. Empty = defaults (/var/log/nginx,/var/log/mysql,...).
# SERVER_SSH_ALLOWED_LOG_PATHS=/var/log/nginx,/var/log/mysql,/var/log/docker

# Filesystem access tools (vee_fs_*)
# Active allowlist profile: production | development | documentation
FS_ALLOWLIST_ENV=development

# Base/fallback read roots (legacy compatible).
# Leave empty to disable all vee_fs_* tools.
# FS_ALLOWED_ROOTS=/workspace/project,/obsidian
FS_ALLOWED_ROOTS=
# Common read roots always merged in all profiles.
# FS_ALLOWED_ROOTS_COMMON=/workspace,/obsidian
FS_ALLOWED_ROOTS_COMMON=
# Profile-specific read roots (merged with common + legacy).
# FS_ALLOWED_ROOTS_PRODUCTION=/var/www/mmcriativos,/obsidian
FS_ALLOWED_ROOTS_PRODUCTION=
# FS_ALLOWED_ROOTS_DEVELOPMENT=/workspace/mmcriativos,/workspace/mmcc
FS_ALLOWED_ROOTS_DEVELOPMENT=
# FS_ALLOWED_ROOTS_DOCUMENTATION=/obsidian,/workspace/docs
FS_ALLOWED_ROOTS_DOCUMENTATION=
# Additional categories merged into read roots:
# Full workspace roots (not only subfolders)
# FS_WORKSPACE_ROOTS=/workspace
FS_WORKSPACE_ROOTS=
# Allowed development repositories
# FS_DEV_REPO_ROOTS=/workspace/mmcriativos,/workspace/mmcc
FS_DEV_REPO_ROOTS=
# Allowed config/scripts/docs/deploy paths
# FS_CONFIG_READ_PATHS=/workspace/mmcriativos/config,/workspace/mmcriativos/scripts,/workspace/mmcriativos/docs,/workspace/mmcriativos/deploy
FS_CONFIG_READ_PATHS=

# Max bytes returned per vee_fs_read_file call (default 256 KB)
FS_MAX_FILE_BYTES=262144
# Enable vee_fs_write_file (default false - read-only by default)
FS_WRITE_ENABLED=false
# Base/fallback write paths (legacy compatible).
# Empty = all configured read roots subtree.
# FS_WRITE_ALLOWED_PATHS=/workspace/project/tmp,/workspace/project/generated
FS_WRITE_ALLOWED_PATHS=
# Common write paths for all profiles.
# FS_WRITE_ALLOWED_PATHS_COMMON=/workspace/mmcriativos/storage/tmp,/workspace/mmcriativos/docs
FS_WRITE_ALLOWED_PATHS_COMMON=
# Profile-specific write paths.
# FS_WRITE_ALLOWED_PATHS_PRODUCTION=/var/www/mmcriativos/storage/app/vee
FS_WRITE_ALLOWED_PATHS_PRODUCTION=
# FS_WRITE_ALLOWED_PATHS_DEVELOPMENT=/workspace/mmcriativos/tmp,/workspace/mmcriativos/docs
FS_WRITE_ALLOWED_PATHS_DEVELOPMENT=
# FS_WRITE_ALLOWED_PATHS_DOCUMENTATION=/obsidian/Sessoes,/workspace/docs
FS_WRITE_ALLOWED_PATHS_DOCUMENTATION=
# Additional categories merged into write paths:
# Operational local write paths
# FS_OPERATION_WRITE_PATHS=/workspace/mmcriativos/storage/logs,/workspace/mmcriativos/tmp
FS_OPERATION_WRITE_PATHS=
# Documentation write paths
# FS_DOCS_WRITE_PATHS=/workspace/mmcriativos/docs,/obsidian/Sessoes
FS_DOCS_WRITE_PATHS=
# Database tools (primary profile: mmcriativos)
DB_READONLY_HOST=
DB_READONLY_PORT=3306
DB_READONLY_USER=
DB_READONLY_PASSWORD=
DB_READONLY_DATABASE=
DB_READONLY_MAX_ROWS=100
DB_READONLY_RATE_LIMIT=10

DB_WRITE_HOST=
DB_WRITE_PORT=3306
DB_WRITE_USER=
DB_WRITE_PASSWORD=
DB_WRITE_DATABASE=
DB_WRITE_ENABLED=false

# Database tools (optional second profile: mmcc)
DB_MMCC_READONLY_HOST=
DB_MMCC_READONLY_PORT=3306
DB_MMCC_READONLY_USER=
DB_MMCC_READONLY_PASSWORD=
DB_MMCC_READONLY_DATABASE=

DB_MMCC_WRITE_HOST=
DB_MMCC_WRITE_PORT=3306
DB_MMCC_WRITE_USER=
DB_MMCC_WRITE_PASSWORD=
DB_MMCC_WRITE_DATABASE=
DB_MMCC_WRITE_ENABLED=false

# Default db target for tools that omit db_target (mmcriativos | mmcc)
DB_DEFAULT_TARGET=mmcriativos

# Optional write-mode grouping overrides (comma-separated logical table names)
# Useful to define MMCC categories and future operational tables without changing code.
# DB_SAFE_EXECUTE_TABLES_MMCRIATIVOS=projects,project_tasks,vee_project_events,vee_status_history,vee_blocks,vee_operational_decisions,vee_execution_notes
DB_SAFE_EXECUTE_TABLES_MMCRIATIVOS=
# DB_SAFE_EXECUTE_TABLES_MMCC=mmcc_projects,mmcc_project_tasks,mmcc_operation_queues,mmcc_operation_logs,mmcc_events,mmcc_status_history,mmcc_internal_tasks
DB_SAFE_EXECUTE_TABLES_MMCC=
# DB_APPROVAL_REQUIRED_TABLES_MMCRIATIVOS=clients,contacts,tenants,users,messages,integrations,billing_invoices
DB_APPROVAL_REQUIRED_TABLES_MMCRIATIVOS=
# DB_APPROVAL_REQUIRED_TABLES_MMCC=clients,contacts,tenants,users,mmcc_messages
DB_APPROVAL_REQUIRED_TABLES_MMCC=
# Optional global fallback lists
DB_SAFE_EXECUTE_TABLES=
DB_APPROVAL_REQUIRED_TABLES=
DB_READ_ONLY_TABLES=

# Optional write constraints for generic vee_db_write
# Required fields (applied to INSERT/UPSERT):
# DB_WRITE_REQUIRED_FIELDS_JSON={"vee_project_events":["entity_type","entity_id","actor","action"]}
DB_WRITE_REQUIRED_FIELDS_JSON=
# Auto-fill strategies for missing fields (supported: uuid, now):
# DB_WRITE_AUTO_FILL_FIELDS_JSON={"vee_operational_decisions":{"decision_id":"uuid"}}
DB_WRITE_AUTO_FILL_FIELDS_JSON=

# Optional DB allowlist overlays (runtime, no new tool needed)
# Add or override table policies without changing source code.
# JSON object keyed by logical table name.
# Example:
# DB_ALLOWLIST_EXTRA_TABLE_POLICIES_JSON={"campaigns":{"table":"campaigns","allowedColumns":"*","blockedColumns":["api_key"],"sensitive":true,"writeMode":"read_only"}}
DB_ALLOWLIST_EXTRA_TABLE_POLICIES_JSON=
# Add or override named views (logical_name -> mysql_view_name).
# Example:
# DB_ALLOWLIST_EXTRA_NAMED_VIEWS_JSON={"campaign_overview":"v_campaign_overview"}
DB_ALLOWLIST_EXTRA_NAMED_VIEWS_JSON=
# Legacy aliases accepted for compatibility:
# DB_QUERY_EXTRA_TABLE_POLICIES_JSON=
# DB_QUERY_EXTRA_NAMED_VIEWS_JSON=

# Public endpoint for Claude connector (optional)
CLAUDE_MCP_PUBLIC_URL=
